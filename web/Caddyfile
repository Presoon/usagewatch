{
    admin off
    auto_https off
}

:80 {
    encode zstd gzip
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'none'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        Cache-Control "no-cache"
    }
    respond /health "ok" 200
    root * /srv/site
    file_server
}
